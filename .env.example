# Скопируйте в .env и заполните. Файл .env не коммитится.

# --- PostgreSQL (сервис postgres в docker compose) ---
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat
POSTGRES_DB=chat

# --- Приложение ---
# Хост postgres — имя сервиса compose. Пароль должен совпадать с POSTGRES_PASSWORD.
DATABASE_URL=postgres://chat:chat@postgres:5432/chat?sslmode=disable

# Данные приложения на https://my.telegram.org
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=default
# Нужен только для `login`, формат E.164 (например +79991234567)
TG_PHONE=

WORKERS=1
JOBS_MAX_ATTEMPTS=10
JOBS_LEASE=2m
JOBS_POLL_INTERVAL=1s
JOBS_RETENTION=168h
JOBS_DEAD_RETENTION=720h
MARK_READ=true
HTTP_ADDR=:8080
# Не меньше 1s и меньше stop_grace_period контейнера (40s в docker-compose.yml)
SHUTDOWN_TIMEOUT=30s

# Логи: LOG_LEVEL — код сервиса, TG_LOG_LEVEL — внутренние логи gotd
LOG_LEVEL=info
LOG_FORMAT=json
TG_LOG_LEVEL=warn
